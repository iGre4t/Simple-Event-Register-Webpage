# Prevent direct web access to configuration files that hold secrets
<FilesMatch "(?i)^(config|sms_config|telegram_config)\.php$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

